# 3. Schema

```sql
-- ── the tenant ───────────────────────────────────────────────────────────
CREATE TABLE agencies (
  id             UUID PRIMARY KEY DEFAULT gen_random_uuid(),
  name           TEXT NOT NULL,
  slug           TEXT UNIQUE NOT NULL,            -- ryzeworks.creo.app
  custom_domain  TEXT UNIQUE,
  status         TEXT NOT NULL DEFAULT 'trial'
    CHECK (status IN ('trial','active','past_due','suspended','cancelled')),
  plan_tier      TEXT NOT NULL DEFAULT 'starter', -- what the AGENCY pays YOU
  max_clients    INT NOT NULL DEFAULT 10,
  max_staff      INT NOT NULL DEFAULT 15,
  branding       JSONB NOT NULL DEFAULT '{}'::jsonb,  -- logo, colours, from-name
  timezone       TEXT NOT NULL DEFAULT 'Asia/Kolkata',
  created_at     TIMESTAMPTZ NOT NULL DEFAULT now(),
  updated_at     TIMESTAMPTZ NOT NULL DEFAULT now()
);

CREATE TABLE teams (
  id          UUID PRIMARY KEY DEFAULT gen_random_uuid(),
  agency_id   UUID NOT NULL REFERENCES agencies(id) ON DELETE CASCADE,
  name        TEXT NOT NULL,
  lead_id     UUID REFERENCES users(id) ON DELETE SET NULL,
  is_active   BOOLEAN NOT NULL DEFAULT true,
  created_at  TIMESTAMPTZ NOT NULL DEFAULT now(),
  CONSTRAINT uq_team_name UNIQUE (agency_id, name)
);

-- membership is a relation, not a column: a person belongs to one home team
-- but can serve clients owned by any team in the agency
CREATE TABLE team_members (
  team_id     UUID NOT NULL REFERENCES teams(id) ON DELETE CASCADE,
  user_id     UUID NOT NULL REFERENCES users(id) ON DELETE CASCADE,
  is_home     BOOLEAN NOT NULL DEFAULT true,
  joined_at   TIMESTAMPTZ NOT NULL DEFAULT now(),
  PRIMARY KEY (team_id, user_id)
);
CREATE UNIQUE INDEX uq_one_home_team ON team_members(user_id) WHERE is_home;

-- capacity in POINTS, per role, per person
ALTER TABLE staff_profiles
  ADD COLUMN agency_id      UUID REFERENCES agencies(id) ON DELETE CASCADE,
  ADD COLUMN craft_role     TEXT NOT NULL DEFAULT 'graphic_designer'
    CHECK (craft_role IN ('video_editor','graphic_designer','content_creator',
                          'social_manager','videographer')),
  ADD COLUMN monthly_points INT NOT NULL DEFAULT 100,
  ADD COLUMN sub_skills     TEXT[] NOT NULL DEFAULT '{}';

-- OWNERSHIP: client belongs to one team
ALTER TABLE users
  ADD COLUMN agency_id UUID REFERENCES agencies(id) ON DELETE CASCADE,
  ADD COLUMN owning_team_id UUID REFERENCES teams(id) ON DELETE SET NULL;

-- ASSIGNMENT: one named person per required role (extends client_assignments)
ALTER TABLE client_assignments
  ADD COLUMN agency_id     UUID REFERENCES agencies(id) ON DELETE CASCADE,
  ADD COLUMN craft_role    TEXT NOT NULL DEFAULT 'graphic_designer',
  ADD COLUMN points_committed INT NOT NULL DEFAULT 0,
  ADD COLUMN from_team_id  UUID REFERENCES teams(id);   -- may differ from owning team
CREATE UNIQUE INDEX uq_one_person_per_craft ON client_assignments(client_id, craft_role)
  WHERE unassigned_at IS NULL;

-- which roles does this client actually need?
CREATE TABLE client_role_requirements (
  client_id   UUID NOT NULL REFERENCES users(id) ON DELETE CASCADE,
  craft_role  TEXT NOT NULL,
  PRIMARY KEY (client_id, craft_role)
);
```

**`agency_id` goes on every tenant-owned table.** Composite index `(agency_id, ...)` on
every high-volume table from day one — retrofitting that at 10M rows is painful.

```sql
CREATE INDEX idx_deliv_tenant ON deliverables(agency_id, client_id, status, created_at DESC);
CREATE INDEX idx_tasks_tenant ON tasks(agency_id, status, assigned_to);
CREATE INDEX idx_cal_tenant   ON content_calendar(agency_id, client_id, slot_date);
```

