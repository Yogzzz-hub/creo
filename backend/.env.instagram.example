# Add these to the existing backend environment. Never put them in VITE_* variables.
# Keep disabled until Meta approval, staging validation and administrator rollout.
INSTAGRAM_PUBLISHING_ENABLED=false
INSTAGRAM_CLIENT_MODE=fake
META_GRAPH_API_VERSION=v26.0
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=https://your-creo-domain.example/portal/account/instagram
# Generate a Fernet key once; share securely between API and workers, retain across restarts.
ENCRYPTION_KEY=
INSTAGRAM_FFPROBE_PATH=ffprobe
INSTAGRAM_MAX_LATENESS_MINUTES=30
# Existing DATABASE_URL, DIRECT_DATABASE_URL, Redis/Celery and storage variables also apply.
