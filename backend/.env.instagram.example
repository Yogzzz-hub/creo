# Server-only settings: never put these in frontend VITE variables.
INSTAGRAM_APP_ID=your_meta_app_id
INSTAGRAM_APP_SECRET=your_meta_app_secret
# Optional: Configuration ID from Facebook Login for Business in this SAME Meta app.
# Choose a user access token and include instagram_basic, instagram_content_publish,
# pages_show_list, and pages_read_engagement in the configuration.
# This is not an Instagram Login app ID, access token, or app secret.
META_LOGIN_CONFIG_ID=
# Generate once: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Use the same key on the API, Celery worker, and scheduler. Keep an existing valid key:
# replacing it makes previously encrypted Instagram credentials unreadable.
ENCRYPTION_KEY=your_generated_fernet_key
INSTAGRAM_REDIRECT_URI=https://creo.yogalakshmibaskar20.workers.dev/portal/account/instagram
INSTAGRAM_CLIENT_MODE=real
# Enable only after OAuth connection and publishing worker are configured.
INSTAGRAM_PUBLISHING_ENABLED=false
META_GRAPH_API_VERSION=v26.0
INSTAGRAM_FFPROBE_PATH=ffprobe
INSTAGRAM_MAX_LATENESS_MINUTES=30
# Existing DATABASE_URL, DIRECT_DATABASE_URL, Redis/Celery and storage settings also apply.

# Optional direct Instagram Login (Business/Creator; no Facebook Page required).
# Copy these from API setup with Instagram login, NOT the Facebook parent app.
INSTAGRAM_LOGIN_APP_ID=
INSTAGRAM_LOGIN_APP_SECRET=
# Uses the same INSTAGRAM_REDIRECT_URI above. Register it in Instagram Login settings.
# Add instagram_business_basic and instagram_business_content_publish.
# Configure API, publishing worker and maintenance worker with the same values.
