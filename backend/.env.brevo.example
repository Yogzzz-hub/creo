# Set these on the API web service and any background worker that sends email.
# Create an API key (not an SMTP key) in Brevo > SMTP & API > API Keys.
# Verify the sender in Brevo > Settings > Senders, Domains, IPs > Senders.
BREVO_API_KEY=replace_with_your_brevo_api_key
BREVO_FROM_EMAIL=your_verified_sender@example.com
BREVO_FROM_NAME=Creo
