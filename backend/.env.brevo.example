# SMTP setup: verify this sender in Brevo and authorize the server's outbound IPs.
# Use 2525 + STARTTLS for free Render services (587 and 465 are blocked).
SMTP_SERVER=smtp-relay.brevo.com
SMTP_PORT=2525
SMTP_USERNAME=your_smtp_login@smtp-brevo.com
SMTP_PASSWORD=replace_with_your_brevo_smtp_key
SMTP_FROM_EMAIL=your_verified_sender@example.com
SMTP_USE_TLS=true
SMTP_USE_SSL=false
BREVO_FROM_NAME=Creo

# Optional HTTPS delivery instead of SMTP: use an API key, not an xsmtpsib key.
# A configured API key and sender take precedence over SMTP.
BREVO_API_KEY=
BREVO_FROM_EMAIL=
