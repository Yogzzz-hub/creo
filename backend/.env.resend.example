# Copy these variables into backend/.env for local verification email testing.
# The code defaults to Creo <onboarding@resend.dev> when the sender is omitted/blank.
# This only sends to your Resend account email. For customer delivery, override
# the sender with an address on a domain verified in your Resend account.
RESEND_API_KEY=re_replace_with_your_resend_api_key
RESEND_FROM_EMAIL="Creo Verification <noreply@mail.yourdomain.com>"
