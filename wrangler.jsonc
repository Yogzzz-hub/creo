{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "creo",
  "compatibility_date": "2026-09-08",
  "observability": {
    "enabled": true
  },
  "build": {
    "command": "cd frontend && npm install && npm run build"
  },
  "assets": {
    "directory": "frontend/dist",
    "not_found_handling": "single-page-application"
  }
}
