# =============================================================================
# Creo Platform — Environment Configuration Template
# =============================================================================

# Application environment ('development', 'staging', 'production')
ENVIRONMENT=development

# Server port for FastAPI backend
PORT=8000

# Primary async PostgreSQL connection string (asyncpg driver)
DATABASE_URL=postgresql+asyncpg://postgres:postgrespassword@localhost:5432/creo

# Direct PostgreSQL connection string (port 5432, bypasses PgBouncer for Alembic migrations)
DIRECT_DATABASE_URL=postgresql+asyncpg://postgres:postgrespassword@localhost:5432/creo

# Redis connection URL for caching, sessions, and rate limiting
REDIS_URL=redis://localhost:6379/0

# Celery broker connection string (Redis)
CELERY_BROKER_URL=redis://localhost:6379/0

# Celery task result backend connection string (Redis)
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# JWT HS256 secret key for signing access tokens (REQUIRED, NO DEFAULT)
JWT_SECRET=

# Access token validity duration in minutes (default: 15)
ACCESS_TOKEN_MINUTES=15

# Refresh token cookie validity duration in days (default: 30)
REFRESH_TOKEN_DAYS=30

# Fernet symmetric encryption key for encrypting sensitive credentials at rest (32 url-safe base64 bytes)
ENCRYPTION_KEY=

# JSON array of allowed origins for CORS headers
BACKEND_CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# Supabase project URL for storage and auth
SUPABASE_URL=

# Supabase service role key (backend only, never expose to client)
SUPABASE_SERVICE_ROLE_KEY=

# Supabase JWT secret for validating storage tokens
SUPABASE_JWT_SECRET=

# Supabase Storage bucket name for deliverables
SUPABASE_STORAGE_BUCKET=creo-deliverables

# Razorpay API key ID for INR payments
RAZORPAY_KEY_ID=

# Razorpay API key secret
RAZORPAY_KEY_SECRET=

# Razorpay webhook signing secret for HMAC verification
RAZORPAY_WEBHOOK_SECRET=

# Stripe secret key for international billing
STRIPE_SECRET_KEY=

# Stripe webhook signing secret for signature verification
STRIPE_WEBHOOK_SECRET=

# Google Gemini API key for Brand DNA generation
GEMINI_API_KEY=

# OpenAI API key as secondary fallback for Brand DNA generation
OPENAI_API_KEY=

# Instagram Graph API application ID
INSTAGRAM_APP_ID=

# Instagram Graph API application secret
INSTAGRAM_APP_SECRET=

# Instagram Graph API OAuth callback redirect URI
INSTAGRAM_REDIRECT_URI=

# Instagram publishing worker mode ('real' or 'fake' for automated testing)
INSTAGRAM_CLIENT_MODE=fake

# SMTP server hostname for transactional email dispatch
SMTP_HOST=

# SMTP server port (e.g. 587 for STARTTLS)
SMTP_PORT=587

# SMTP authentication username
SMTP_USER=

# SMTP authentication password
SMTP_PASSWORD=

# Google OAuth 2.0 Client ID for PKCE authentication
GOOGLE_CLIENT_ID=

# Google OAuth 2.0 Client Secret
GOOGLE_CLIENT_SECRET=

# Google OAuth 2.0 redirect URI
GOOGLE_REDIRECT_URI=

# Sentry DSN for backend error and trace tracking
SENTRY_DSN=

# --- Frontend Variables (VITE_ prefix denotes public variables) ---

# Frontend API base URL (empty defaults to same-origin /api proxy)
VITE_API_BASE_URL=

# Public Supabase project URL for assets
VITE_SUPABASE_URL=

# Public Supabase anonymous API key
VITE_SUPABASE_ANON_KEY=

# Public Razorpay key ID for browser checkout modal
VITE_RAZORPAY_KEY_ID=

# Public Sentry DSN for frontend crash logging
VITE_SENTRY_DSN=
