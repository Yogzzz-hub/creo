{
  "name": "creo-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "check": "biome check .",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "cap:sync": "npm run build && cap sync",
    "cap:android": "npm run cap:sync && cap open android",
    "cap:ios": "npm run cap:sync && cap open ios",
    "cap:run:android": "npm run cap:sync && cap run android",
    "cap:assets": "npx --yes @capacitor/assets@3.0.5 generate --android --ios --assetPath resources --iconBackgroundColor \"#161929\" --iconBackgroundColorDark \"#161929\" --splashBackgroundColor \"#0F0E0C\" --splashBackgroundColorDark \"#0F0E0C\""
  },
  "allowScripts": {
    "@biomejs/biome": true,
    "core-js": true,
    "esbuild": true
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/core": "^8.5.3",
    "@capacitor/ios": "^8.5.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/utilities": "^3.2.2",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-toast": "^1.2.23",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@supabase/supabase-js": "^2.116.0",
    "@tailwindcss/vite": "^4.0.9",
    "@tanstack/react-query": "^5.66.9",
    "@types/three": "^0.186.0",
    "clsx": "^2.1.1",
    "jspdf": "^4.2.1",
    "lenis": "^1.3.26",
    "lucide-react": "^1.59.0",
    "motion": "^12.4.7",
    "react": "^19.0.0",
    "react-color-palette": "^7.3.1",
    "react-dom": "^19.0.0",
    "react-router": "^7.2.0",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.0.1",
    "tailwindcss": "^4.0.9",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@capacitor/cli": "^8.5.3",
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "rollup-plugin-visualizer": "^7.1.1",
    "typescript": "~5.7.3",
    "vite": "^6.2.0"
  }
}
