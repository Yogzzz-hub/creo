# Database — Supabase PostgreSQL with PgBouncer pooler (Must use Transaction Mode port 6543)
DATABASE_URL=postgresql+asyncpg://postgres:[YOUR-PASSWORD]@aws-1-ap-northeast-2.pooler.supabase.com:6543/postgres

# Supabase
SUPABASE_URL=https://[YOUR-PROJECT].supabase.co
SUPABASE_SERVICE_ROLE_KEY=[YOUR-SERVICE-ROLE-KEY]
SUPABASE_JWT_SECRET=[YOUR-JWT-SECRET]

# MSG91 (Required for SMS Delivery)
MSG91_AUTH_KEY=[YOUR-MSG91-AUTH-KEY]
MSG91_SENDER_ID=[YOUR-MSG91-SENDER-ID]
MSG91_WHATSAPP_NUMBER=[YOUR-MSG91-WHATSAPP-NUMBER]

# Third-party Integrations (Optional)
GEMINI_API_KEY=
OPENAI_API_KEY=
DIFY_API_KEY=
DIFY_API_URL=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_STARTER_PLAN_ID=
RAZORPAY_GROWTH_PLAN_ID=
RAZORPAY_PRO_PLAN_ID=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=


# Redis / Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0

# CORS Configuration
# A list or comma-separated string of frontend origins allowed by CORS middleware.
# Local development default: http://localhost:3000,http://127.0.0.1:3000
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://creo-web.vercel.app
