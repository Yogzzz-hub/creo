import numpy as np
import matplotlib.pyplot as plt

from sklearn.datasets import fetch_lfw_people
from sklearn.model_selection import train_test_split

from tensorflow.keras.models import Sequential
from tensorflow.keras.layers import Conv2D, MaxPooling2D
from tensorflow.keras.layers import Flatten, Dense
from tensorflow.keras.utils import to_categorical


# LOAD DATA
faces = fetch_lfw_people(
    min_faces_per_person=100,
    resize=0.5
)

X = faces.images
y = faces.target

print("Image shape:", X.shape)
print("People:", faces.target_names)


# ADD CHANNEL
X = X.reshape(
    X.shape[0],
    X.shape[1],
    X.shape[2],
    1
)

# NORMALIZE
X = X / 255

# ONE HOT
y = to_categorical(y)


# SPLIT
X_train, X_test, y_train, y_test = train_test_split(
    X,
    y,
    test_size=0.2
)


# CNN
model = Sequential()

model.add(
    Conv2D(
        32,
        (3,3),
        activation="relu",
        input_shape=X.shape[1:]
    )
)

model.add(
    MaxPooling2D((2,2))
)

model.add(
    Conv2D(
        64,
        (3,3),
        activation="relu"
    )
)

model.add(
    MaxPooling2D((2,2))
)

model.add(Flatten())

model.add(
    Dense(
        128,
        activation="relu"
    )
)

model.add(
    Dense(
        len(faces.target_names),
        activation="softmax"
    )
)


# COMPILE
model.compile(
    optimizer="adam",
    loss="categorical_crossentropy",
    metrics=["accuracy"]
)


# TRAIN
history = model.fit(
    X_train,
    y_train,
    epochs=5,
    validation_data=(X_test, y_test)
)


# PREDICT
prediction = model.predict(X_test)

first_prediction = prediction[0]

person_number = np.argmax(first_prediction)

person_name = faces.target_names[person_number]


# SHOW FACE
image = X_test[0]

plt.imshow(
    image.reshape(image.shape[0], image.shape[1]),
    cmap="gray"
)

plt.title("Prediction: " + person_name)

plt.show()


# ACCURACY GRAPH
plt.plot(history.history["accuracy"])

plt.plot(history.history["val_accuracy"])

plt.xlabel("Epoch")

plt.ylabel("Accuracy")

plt.show()

EX 4 — Language Modeling Using RNN
import glob
import numpy as np
import matplotlib.pyplot as plt

from tensorflow.keras.models import Sequential
from tensorflow.keras.layers import SimpleRNN, Dense


# ---------------------------
# 1. READ NAMES
# ---------------------------

files = glob.glob("data/names/*.txt")

text = ""

for file in files:

    f = open(file, encoding="utf-8")

    text = text + f.read()

    f.close()


# ---------------------------
# 2. GET CHARACTERS
# ---------------------------

chars = sorted(set(text))

char_to_num = {}

for i in range(len(chars)):

    char_to_num[chars[i]] = i


num_to_char = {}

for i in range(len(chars)):

    num_to_char[i] = chars[i]


# ---------------------------
# 3. CREATE X AND y
# ---------------------------

X = []
y = []


for i in range(len(text) - 1):

    current_char = text[i]

    next_char = text[i + 1]

    X.append(
        char_to_num[current_char]
    )

    y.append(
        char_to_num[next_char]
    )


# ---------------------------
# 4. CONVERT TO ARRAY
# ---------------------------

X = np.array(X)

y = np.array(y)


# RNN needs 3 dimensions
X = X.reshape(
    X.shape[0],
    1,
    1
)


# NORMALIZE
X = X / len(chars)


# ---------------------------
# 5. CREATE RNN
# ---------------------------

model = Sequential()


model.add(
    SimpleRNN(
        64,
        input_shape=(1,1)
    )
)


model.add(
    Dense(
        len(chars),
        activation="softmax"
    )
)


# ---------------------------
# 6. COMPILE
# ---------------------------

model.compile(
    optimizer="adam",
    loss="sparse_categorical_crossentropy",
    metrics=["accuracy"]
)


# ---------------------------
# 7. TRAIN
# ---------------------------

history = model.fit(
    X,
    y,
    epochs=10
)


# ---------------------------
# 8. PREDICT
# ---------------------------

letter = "A"

number = char_to_num[letter]

input_data = np.array([number])

input_data = input_data.reshape(1,1,1)

input_data = input_data / len(chars)


prediction = model.predict(input_data)

next_number = np.argmax(prediction)

next_letter = num_to_char[next_number]


print(
    "Input Character:",
    letter
)

print(
    "Predicted Next Character:",
    next_letter
)


# ---------------------------
# 9. LOSS GRAPH
# ---------------------------

plt.plot(
    history.history["loss"]
)

plt.xlabel("Epoch")

plt.ylabel("Loss")

plt.title("Training Loss")

plt.show()


