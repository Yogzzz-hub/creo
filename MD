from tensorflow.keras.preprocessing.sequence import pad_sequences


# LOAD CSV
data = pd.read_csv("IMDBDataset.csv")


# INPUT
X = data["review"]


# OUTPUT
y = data["sentiment"]

# CONVERT LABELS
y = y.replace(
    {
        "positive": 1,
        "negative": 0
    }
)


# TOKENIZER
tokenizer = Tokenizer(
    num_words=5000
)

tokenizer.fit_on_texts(X)


# TEXT → NUMBERS
X = tokenizer.texts_to_sequences(X)


# SAME LENGTH
X = pad_sequences(
    X,
    maxlen=200
)


# SPLIT
X_train, X_test, y_train, y_test = train_test_split(
    X,
    y,
    test_size=0.2
)


# LSTM MODEL
