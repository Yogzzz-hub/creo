EX 6 — POS Tagging

import pandas as pd


# -------------------------
# READ DATA
# -------------------------

data = pd.read_csv(
    "data1/train",
    sep="\t",
    names=["index", "word", "POS"]
)


print(data.head())


# -------------------------
# CREATE WORD → POS TABLE
# -------------------------

word_pos = {}


for i in range(len(data)):

    word = data["word"][i]

    pos = data["POS"][i]


    if word not in word_pos:

        word_pos[word] = {}


    if pos not in word_pos[word]:

        word_pos[word][pos] = 0


    word_pos[word][pos] += 1


# -------------------------
# PREDICT FUNCTION
# -------------------------

def predict_pos(word):

    if word not in word_pos:

        return "<unk>"


    tags = word_pos[word]


    best_tag = max(
        tags,
        key=tags.get
    )


    return best_tag


# -------------------------
# TEST
# -------------------------

sentence = "The dog runs"


words = sentence.split()


for word in words:

    tag = predict_pos(word)

    print(
        word,
        "->",
        tag
    )


EX 7 — Machine Translation

import numpy as np

from tensorflow.keras.models import Sequential
from tensorflow.keras.layers import Embedding
from tensorflow.keras.layers import LSTM
from tensorflow.keras.layers import Dense
from tensorflow.keras.preprocessing.text import Tokenizer
from tensorflow.keras.preprocessing.sequence import pad_sequences


# -------------------------
# READ fra.txt
# -------------------------

file = open(
    "fra.txt",
    encoding="utf-8"
)

lines = file.readlines()

file.close()


english = []
french = []


# USE FIRST 1000 SENTENCES
for line in lines[:1000]:

    parts = line.split("\t")

    english.append(
        parts[0]
    )

    french.append(
        parts[1]
    )


print(
    english[0],
    "->",
    french[0]
)


# -------------------------
# TOKENIZER
# -------------------------

tokenizer = Tokenizer()


tokenizer.fit_on_texts(
    english + french
)


# TEXT → NUMBERS
X = tokenizer.texts_to_sequences(
    english
)

y = tokenizer.texts_to_sequences(
    french
)


# -------------------------
# PADDING
# -------------------------

X = pad_sequences(
    X,
    maxlen=10
)

y = pad_sequences(
    y,
    maxlen=10
)


# -------------------------
# VOCABULARY SIZE
# -------------------------

vocab_size = len(
    tokenizer.word_index
) + 1


# -------------------------
# MODEL
# -------------------------

model = Sequential()


model.add(
    Embedding(
        vocab_size,
        64
    )
)


model.add(
    LSTM(
        64,
        return_sequences=True
    )
)


model.add(
    Dense(
        vocab_size,
        activation="softmax"
    )
)


# -------------------------
# COMPILE
# -------------------------

model.compile(
    optimizer="adam",
    loss="sparse_categorical_crossentropy",
    metrics=["accuracy"]
)


# -------------------------
# TRAIN
# -------------------------

model.fit(
    X,
    y,
    epochs=10
)

EX 8 — Image Augmentation

import tensorflow as tf
import matplotlib.pyplot as plt

from tensorflow.keras.utils import load_img
from tensorflow.keras.utils import img_to_array


# -------------------------
# LOAD IMAGE
# -------------------------

image = load_img(
    "arctic-wildlife/train/arctic_fox/image.jpg",
    target_size=(224,224)
)


# IMAGE → ARRAY
image = img_to_array(
    image
)


# -------------------------
# AUGMENTATION
# -------------------------

model = tf.keras.Sequential()


model.add(
    tf.keras.layers.RandomFlip(
        "horizontal"
    )
)


model.add(
    tf.keras.layers.RandomRotation(
        0.2
    )
)


# -------------------------
# ADD BATCH
# -------------------------

image = tf.expand_dims(
    image,
    0
)


# -------------------------
# CREATE NEW IMAGE
# -------------------------

new_image = model(
    image
)


# -------------------------
# ORIGINAL
# -------------------------

plt.imshow(
    image[0] / 255
)

plt.title(
    "Original Image"
)

plt.show()


# -------------------------
# AUGMENTED
# -------------------------

plt.imshow(
    new_image[0] / 255
)

plt.title(
    "Augmented Image"
)

plt.show()